msgstr "Giriş bloklanıb: Yalnız %s domenindən olan hesablar qəbul edilir."

msgid "The user \"%s\" would be created successfully."
msgstr "\"%s\" istifadəçisi uğurla yaradılacaq."

msgid ""
"The plugin removes the incorrect profiles assigned by GLPI and explicitly "
"links the profile <strong>%s</strong> and entity <strong>%s</strong> using "
"the <code>Profile_User</code> class."
msgstr ""
"Plugin GLPI tərəfindən təyin edilmiş yanlış profilləri silir və açıq şəkildə"
" <code>Profile_User</code> sinfindən istifadə edərək <strong>%s</strong> "
"profilini və <strong>%s</strong> obyektini əlaqələndirir."

msgid "Email Validation"
msgstr "E-poçt Doğrulaması"

