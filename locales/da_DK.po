#
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Add Rule"
msgstr "Tilføj Regel"

msgid ""
"Add rules to define which profile and entity the user will receive based on "
"their email domain (Optional)."
msgstr ""
"Tilføj regler for at definere, hvilken profil og enhed brugeren vil modtage "
"baseret på deres e-mail-domæne (Valgfrit)."

msgid "Automatically create users on first login"
msgstr "Opret brugere automatisk ved første login"

msgid "Configuration updated."
msgstr "Konfiguration opdateret."

msgid "Default Rule (Fallback)"
msgstr "Standardregel (Fallback)"

msgid "Default entity (ELSE)"
msgstr "Standardenhed (ELSE)"

msgid "Default profile (ELSE)"
msgstr "Standardprofil (ELSE)"

msgid "Domain (after @)"
msgstr "Domæne (efter @)"

msgid "Entity"
msgstr "Enhed"

msgid "Failed to create the user in GLPI."
msgstr "Kunne ikke oprette brugeren i GLPI."

msgid "Google SSO"
msgstr "Google SSO"

msgid "Google SSO — Configuration"
msgstr "Google SSO — Konfiguration"

msgid "Google authentication failed: %s"
msgstr "Google-godkendelse mislykkedes: %s"

msgid "Google login cancelled: %s"
msgstr "Google-login annulleret: %s"

msgid "Google response without authorization code."
msgstr "Google-svar uden autorisationskode."

msgid ""
"If the user email does not match any of the rules above, this profile and "
"entity will be used. Mandatory if automatic creation is enabled."
msgstr ""
"Hvis brugerens e-mail ikke matcher nogen af ovenstående regler, vil denne "
"profil og enhed blive brugt. Obligatorisk, hvis automatisk oprettelse er "
"aktiveret."

msgid "Invalid OAuth2 state. Try again from the login page."
msgstr "Ugyldig OAuth2-tilstand. Prøv igen fra login-siden."

msgid "Leave blank to keep current secret (stored encrypted)."
msgstr "Efterlad tom for at beholde nuværende hemmelighed (gemt krypteret)."

msgid "No GLPI user corresponds to this Google account."
msgstr "Ingen GLPI-bruger svarer til denne Google-konto."

msgid "Only accounts from the %s domain are accepted."
msgstr "Kun konti fra %s-domænet accepteres."

msgid "Profile"
msgstr "Profil"

msgid "Profile and Entity Rules by Domain"
msgstr "Profil- og enhedsregler efter domæne"

msgid "Register this Redirect URI in Google Cloud Console:"
msgstr "Registrer denne omdirigerings-URI i Google Cloud Console:"

msgid "Restrict to domain (optional)"
msgstr "Begræns til domæne (valgfrit)"

msgid "Save"
msgstr "Gem"

msgid "Select..."
msgstr "Vælg..."

msgid "Session not initialized: user has no enabled profile."
msgstr "Session ikke initialiseret: bruger har ingen aktiveret profil."

msgid "Sign in with Google"
msgstr "Log ind med Google"

msgid "The Google account does not have a verified email."
msgstr "Google-kontoen har ikke en bekræftet e-mail."

msgid "This user is deactivated in GLPI."
msgstr "Denne bruger er deaktiveret i GLPI."

msgid "or"
msgstr "eller"

msgid ""
"Leave the option <strong>\"Remove domain of logins in form "
"login@domain\"</strong> as <strong>No</strong>. If enabled, users with the "
"same prefix in different providers (e.g., admin@gmail.com and "
"admin@institution.edu.br) will suffer account overlap."
msgstr ""
"Lad indstillingen <strong>\"Fjern domæne af logins i form "
"login@domæne\"</strong> være <strong>Nej</strong>. Hvis det er aktiveret, "
"vil brugere med det samme præfiks hos forskellige udbydere (f.eks. "
"admin@gmail.com og admin@institution.edu.br) lide over kontooverlapning."

msgid ""
"Check the <strong>Activate \"Sign in with Google\" button</strong> option "
"below and click <strong>Save</strong>."
msgstr ""
"Marker knappen <strong>Aktiver \"Log ind med Google\"</strong> nedenfor, og "
"klik på <strong>Gem</strong>."

msgid ""
"Change the <strong>Automatically add users from an external authentication "
"source</strong> field to <strong>Yes</strong>."
msgstr ""
"Skift feltet <strong>Tilføj automatisk brugere fra en ekstern "
"godkendelseskilde</strong> til <strong>Ja</strong>."

msgid "Step 1: Google Cloud Preparation"
msgstr "Trin 1: Google Cloud-forberedelse"

msgid "Critical Warning:"
msgstr "Kritisk advarsel:"

msgid "How to enable Google SSO integration?"
msgstr "Hvordan aktiverer man Google SSO-integration?"

msgid ""
"Google will generate a <strong>Client ID</strong> and a <strong>Client "
"Secret</strong>. Fill in the fields in this form with those keys."
msgstr ""
"Google genererer et <strong>klient-id</strong> og en "
"<strong>klienthemmelighed</strong>. Udfyld felterne i denne formular med "
"disse nøgler."

msgid ""
"Access the <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a> and create a new "
"<strong>Project</strong>."
msgstr ""
"Få adgang til <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a>, og opret et nyt "
"<strong>projekt</strong>."

msgid "Redirect URI:"
msgstr "Omdirigerings-URI:"

msgid "Activate \"Sign in with Google\" button"
msgstr "Aktiver knappen \"Log ind med Google\"."

msgid ""
"Then go to <strong>Credentials &gt; Create Credentials &gt; OAuth client "
"ID</strong>, choosing the <strong>Web application</strong> type."
msgstr ""
"Gå derefter til <strong>legitimationsoplysninger &gt; Opret "
"legitimationsoplysninger &gt; OAuth-klient-id</strong>, ved at vælge typen "
"<strong>Webapplikation</strong>."

msgid "Step 2: GLPI Authentication Preparation"
msgstr "Trin 2: Forberedelse af GLPI-godkendelse"

msgid ""
"Go to <strong>APIs &amp; Services &gt; OAuth consent screen</strong> and "
"configure your app (add the scopes <code>email</code>, <code>profile</code>,"
" and <code>openid</code>)."
msgstr ""
"Gå til <strong>API'er &amp; Tjenester &gt; OAuth-samtykkeskærmen</strong> og"
" konfigurer din app (tilføj omfanget <code>e-mail</code>, "
"<code>profil</code> og <code>openid</code>)."

msgid "In GLPI, go to <strong>Setup &gt; Authentication &gt; Setup</strong>."
msgstr ""
"I GLPI skal du gå til <strong>Opsætning &gt; Godkendelse &gt; "
"Opsætning</strong>."

msgid ""
"Under <strong>Authorized redirect URIs</strong>, copy and paste exactly the "
"return URL below:"
msgstr ""
"Under <strong>Autoriserede omdirigerings-URI'er</strong> skal du kopiere og "
"indsætte nøjagtigt returwebadressen nedenfor:"

msgid ""
"Subdomains are also accepted. E.g.: \"company.com\" will allow "
"user@company.com and user@sub.company.com."
msgstr ""
"Underdomæner accepteres også. F.eks.: \"company.com\" tillader "
"user@company.com og user@sub.company.com."

msgid ""
"To test the account creation rules and discover which Profile/Entity will be"
" assigned to an email,"
msgstr ""
"For at teste reglerne for kontooprettelse og finde ud af, hvilken "
"profil/enhed der vil blive tildelt en e-mail,"

msgid ""
"The plugin calls <code>Session::init()</code>. The GLPI core loads the "
"user\\'s profiles and starts the session. The user is redirected to the "
"dashboard."
msgstr ""
"Pluginnet kalder <code>Session::init()</code>. GLPI-kernen indlæser "
"brugerens profiler og starter sessionen. Brugeren omdirigeres til "
"dashboardet."

msgid "Error Creating Account"
msgstr "Fejl under oprettelse af konto"

msgid "No Profile Configured"
msgstr "Ingen profil konfigureret"

msgid "Database Search"
msgstr "Databasesøgning"

msgid "Do you wish to proceed and create your account now?"
msgstr "Ønsker du at fortsætte og oprette din konto nu?"

msgid "click here"
msgstr "klik her"

msgid "Auto Creation Disabled"
msgstr "Automatisk oprettelse deaktiveret"

msgid "Rules Simulator"
msgstr "Regel Simulator"

msgid ""
"The system would log into the existing account <strong>%s</strong> (ID: %d)."
" No new account would be created."
msgstr ""
"Systemet vil logge ind på den eksisterende konto <strong>%s</strong> (ID: "
"%d). Der ville ikke blive oprettet en ny konto."

msgid "▶️ Simulate Login"
msgstr "▶️ Simuler login"

msgid ""
"Extracted domain: <strong>@%s</strong>. Applied rule: <strong>%s</strong>"
msgstr ""
"Udtrukket domæne: <strong>@%s</strong>. Anvendt regel: <strong>%s</strong>"

msgid "Configuration Read"
msgstr "Konfigurationslæsning"

msgid "User \"%s\" already exists. Login would be performed successfully."
msgstr "Brugeren \"%s\" eksisterer allerede. Login ville blive udført med succes."

msgid ""
"The email domain \"<strong>%s</strong>\" is not allowed. The plugin "
"restricts access to the domain \"<strong>%s</strong>\" or its subdomains."
msgstr ""
"E-mail-domænet \"<strong>%s</strong>\" er ikke tilladt. Pluginnet begrænser "
"adgangen til domænet \"<strong>%s</strong>\" eller dets underdomæner."

msgid ""
"The plugin calls <code>User::add()</code> to create the user "
"\"<strong>%s</strong>\"."
msgstr ""
"Pluginnet kalder <code>Bruger::add()</code> for at oprette brugeren "
"\"<strong>%s</strong>\"."

msgid "using the primary email:"
msgstr "ved at bruge den primære e-mail:"

msgid "User::add() called"
msgstr "Bruger::add() kaldet"

msgid "Profile Determined by Plugin"
msgstr "Profil bestemt af plugin"

msgid ""
"Profile: <strong>%s</strong> (ID: %d) | Entity: <strong>%s</strong> (ID: %d)"
msgstr ""
"Profil: <strong>%s</strong> (ID: %d) | Enhed: <strong>%s</strong> (ID: %d)"

msgid ""
"The email domain \"<strong>%s</strong>\" is allowed by the restriction rule."
msgstr "E-mail-domænet \"<strong>%s</strong>\" er tilladt af begrænsningsreglen."

msgid "Core Default Profile Assigned"
msgstr "Kernestandardprofil tildelt"

msgid "Verified email present: <strong>%s</strong>"
msgstr "Bekræftet e-mail til stede: <strong>%s</strong>"

msgid "The user \"%s\" DOES NOT exist and auto-creation is disabled."
msgstr "Brugeren \"%s\" eksisterer IKKE, og automatisk oprettelse er deaktiveret."

msgid "Profile Correction by Plugin"
msgstr "Profilkorrektion med plugin"

msgid "Yes"
msgstr "Ja"

msgid "To access the system via Google, a new account will be created for"
msgstr "For at få adgang til systemet via Google oprettes en ny konto til"

msgid "Rule Used"
msgstr "Regel brugt"

msgid "Plugin googlesso step"
msgstr "Plugin googlesso trin"

msgid "Simulator:"
msgstr "Simulator:"

msgid "Account Creation Required"
msgstr "Kontooprettelse påkrævet"

msgid "Domain Rule for \"%s\""
msgstr "Domæneregel for \"%s\""

msgid ""
"This simulator faithfully reproduces the entire execution chain — from the "
"plugin logic to the internal GLPI Core behavior. Enter an email and see "
"step-by-step what would happen in a real login."
msgstr ""
"Denne simulator gengiver trofast hele udførelseskæden - fra plugin-logikken "
"til den interne GLPI Core-adfærd. Indtast en e-mail og se trin-for-trin, "
"hvad der ville ske ved et rigtigt login."

msgid "Back to configuration"
msgstr "Tilbage til konfiguration"

msgid "Account Creation Confirmation"
msgstr "Bekræftelse af kontooprettelse"

msgid "Domain Rules"
msgstr "Domæneregler"

msgid "Account Creation Simulator"
msgstr "Simulator for oprettelse af konto"

msgid "No"
msgstr "Ingen"

msgid "No user found with the email <strong>%s</strong>"
msgstr "Ingen bruger fundet med e-mailen <strong>%s</strong>"

msgid "Login / Email"
msgstr "Login / Email"

msgid ""
"The \"Automatically create users\" configuration is "
"<strong>DISABLED</strong>. The login would be blocked."
msgstr ""
"Konfigurationen \"Opret brugere automatisk\" er "
"<strong>DEAKTIVERET</strong>. Login vil blive blokeret."

msgid "(none)"
msgstr "(ingen)"

msgid "Login blocked: Only accounts from the %s domain are accepted."
msgstr "Login blokeret: Kun konti fra %s-domænet accepteres."

msgid "The user \"%s\" would be created successfully."
msgstr "Brugeren \"%s\" ville blive oprettet."

msgid ""
"The plugin removes the incorrect profiles assigned by GLPI and explicitly "
"links the profile <strong>%s</strong> and entity <strong>%s</strong> using "
"the <code>Profile_User</code> class."
msgstr ""
"Pluginnet fjerner de forkerte profiler tildelt af GLPI og linker eksplicit "
"profilen <strong>%s</strong> og entiteten <strong>%s</strong> ved hjælp af "
"klassen <code>Profile_User</code>."

msgid "Email Validation"
msgstr "E-mail validering"

msgid "User found by email: <strong>%s</strong> (ID: %d)"
msgstr "Bruger fundet via e-mail: <strong>%s</strong> (ID: %d)"

msgid "Domain Restriction Check"
msgstr "Kontrol af domænebegrænsning"

msgid "None"
msgstr "Ingen"

msgid "Session::init() — Login Performed"
msgstr "Session::init() — Login udført"

msgid "Execution Chain (Step-by-Step)"
msgstr "Udførelseskæde (trin-for-trin)"

msgid "Login to Existing Account"
msgstr "Log ind på eksisterende konto"

msgid "How it works:"
msgstr "Sådan fungerer det:"

msgid ""
"In GLPI 11, the core ignores the profile passed by external authentications "
"and automatically assigns the global default profile (usually Self-Service) "
"to the new user."
msgstr ""
"I GLPI 11 ignorerer kernen profilen, der sendes af eksterne godkendelser, og"
" tildeler automatisk den globale standardprofil (normalt selvbetjening) til "
"den nye bruger."

msgid "Final Entity"
msgstr "Endelig enhed"

msgid "Final Result"
msgstr "Endeligt resultat"

msgid "Back to Login"
msgstr "Tilbage til Login"

msgid "Simulated Email:"
msgstr "Simuleret e-mail:"

msgid ""
"Restrict domain: <strong>%s</strong> | Auto create users: "
"<strong>%s</strong>"
msgstr ""
"Begræns domæne: <strong>%s</strong> | Opret brugere automatisk: "
"<strong>%s</strong>"

msgid "Final Profile"
msgstr "Endelig profil"

msgid ""
"The user \"%s\" would be created, but without ANY profile. Access to GLPI "
"would be denied. Please configure a valid profile in the Default Rule or "
"Domain Rules."
msgstr ""
"Brugeren \"%s\" ville blive oprettet, men uden NOGEN profil. Adgang til GLPI"
" ville blive nægtet. Konfigurer venligst en gyldig profil i standardreglen "
"eller domænereglerne."

msgid "GLPI Core step"
msgstr "GLPI Core trin"

msgid ""
"No valid profile (ID > 0) was found in the plugin rules. The user would be "
"created WITHOUT a profile."
msgstr ""
"Ingen gyldig profil (ID > 0) blev fundet i plugin-reglerne. Brugeren ville "
"blive oprettet UDEN en profil."
