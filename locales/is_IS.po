#
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Add Rule"
msgstr "Bæta við Reglu"

msgid ""
"Add rules to define which profile and entity the user will receive based on "
"their email domain (Optional)."
msgstr ""
"Bættu við reglum til að skilgreina hvaða prófíl og einingu notandinn fær út "
"frá tölvupóstléni þeirra (Valfrjálst)."

msgid "Automatically create users on first login"
msgstr "Búa notendur sjálfkrafa til við fyrstu innskráningu"

msgid "Configuration updated."
msgstr "Stillingar uppfærðar."

msgid "Default Rule (Fallback)"
msgstr "Sjálfgefin Regla (Fallback)"

msgid "Default entity (ELSE)"
msgstr "Sjálfgefin eining (ANNARS)"

msgid "Default profile (ELSE)"
msgstr "Sjálfgefinn prófíll (ANNARS)"

msgid "Domain (after @)"
msgstr "Lén (á eftir @)"

msgid "Entity"
msgstr "Eining"

msgid "Failed to create the user in GLPI."
msgstr "Mistókst að búa til notandann í GLPI."

msgid "Google SSO"
msgstr "Google SSO"

msgid "Google SSO — Configuration"
msgstr "Google SSO — Stillingar"

msgid "Google authentication failed: %s"
msgstr "Google auðkenning mistókst: %s"

msgid "Google login cancelled: %s"
msgstr "Hætt við Google innskráningu: %s"

msgid "Google response without authorization code."
msgstr "Svar frá Google án heimildarkóða."

msgid ""
"If the user email does not match any of the rules above, this profile and "
"entity will be used. Mandatory if automatic creation is enabled."
msgstr ""
"Ef tölvupóstur notandans passar ekki við neina af reglunum hér að ofan verða"
" þessi prófíll og eining notuð. Skylda ef sjálfvirk stofnun er virk."

msgid "Invalid OAuth2 state. Try again from the login page."
msgstr "Ógild OAuth2 staða. Reyndu aftur frá innskráningarsíðunni."

msgid "Leave blank to keep current secret (stored encrypted)."
msgstr ""
"Skildu eftir autt til að halda núverandi leyndarmáli (geymt dulkóðað)."

msgid "No GLPI user corresponds to this Google account."
msgstr "Enginn GLPI notandi samsvarar þessum Google reikningi."

msgid "Only accounts from the %s domain are accepted."
msgstr "Aðeins reikningar frá léninu %s eru samþykktir."

msgid "Profile"
msgstr "Prófíl"

msgid "Profile and Entity Rules by Domain"
msgstr "Reglur um Prófíl og Einingu eftir léni"

msgid "Register this Redirect URI in Google Cloud Console:"
msgstr "Skráðu þetta áframsendingar URI í Google Cloud Console:"

msgid "Restrict to domain (optional)"
msgstr "Takmarka við lén (valfrjálst)"

msgid "Save"
msgstr "Vista"

msgid "Select..."
msgstr "Veldu..."

msgid "Session not initialized: user has no enabled profile."
msgstr "Lotu ekki hafin: notandinn hefur ekki virkjaðan prófíl."

msgid "Sign in with Google"
msgstr "Skráðu þig inn með Google"

msgid "The Google account does not have a verified email."
msgstr "Google reikningurinn hefur ekki staðfesta tölvupóstfang."

msgid "This user is deactivated in GLPI."
msgstr "Þessi notandi er óvirkur í GLPI."

msgid "or"
msgstr "eða"

msgid ""
"Leave the option <strong>\"Remove domain of logins in form "
"login@domain\"</strong> as <strong>No</strong>. If enabled, users with the "
"same prefix in different providers (e.g., admin@gmail.com and "
"admin@institution.edu.br) will suffer account overlap."
msgstr ""
"Skildu eftir valkostinn <strong>\"Fjarlægja innskráningarlén á formi "
"login@lén\"</strong> sem <strong>Nei</strong>. Ef það er virkt munu notendur"
" með sama forskeyti í mismunandi veitum (t.d. admin@gmail.com og "
"admin@institution.edu.br) verða fyrir skarun á reikningum."

msgid ""
"Check the <strong>Activate \"Sign in with Google\" button</strong> option "
"below and click <strong>Save</strong>."
msgstr ""
"Merktu við <strong>Virkja „Skráðu þig inn með Google“ hnappinn</strong> "
"fyrir neðan og smelltu á <strong>Vista</strong>."

msgid ""
"Change the <strong>Automatically add users from an external authentication "
"source</strong> field to <strong>Yes</strong>."
msgstr ""
"Breyttu reitnum <strong>Bæta notendum sjálfkrafa við úr ytri "
"auðkenningaruppsprettu</strong> í <strong>Já</strong>."

msgid "Step 1: Google Cloud Preparation"
msgstr "Skref 1: Google Cloud Undirbúningur"

msgid "Critical Warning:"
msgstr "Mikilvæg viðvörun:"

msgid "How to enable Google SSO integration?"
msgstr "Hvernig á að virkja Google SSO samþættingu?"

msgid ""
"Google will generate a <strong>Client ID</strong> and a <strong>Client "
"Secret</strong>. Fill in the fields in this form with those keys."
msgstr ""
"Google mun búa til <strong>Client ID</strong> og <strong>Client "
"Secret</strong>. Fylltu út reitina á þessu eyðublaði með þessum lyklum."

msgid ""
"Access the <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a> and create a new "
"<strong>Project</strong>."
msgstr ""
"Fáðu aðgang að <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a> og búðu til nýtt "
"<strong>verkefni</strong>."

msgid "Redirect URI:"
msgstr "Tilvísunarvefslóð:"

msgid "Activate \"Sign in with Google\" button"
msgstr "Virkjaðu „Skráðu þig inn með Google“ hnappinn"

msgid ""
"Then go to <strong>Credentials &gt; Create Credentials &gt; OAuth client "
"ID</strong>, choosing the <strong>Web application</strong> type."
msgstr ""
"Farðu síðan í <strong>Skírteini &gt; Búa til skilríki &gt; OAuth "
"biðlaraauðkenni</strong>, með því að velja <strong>vefforrit</strong> gerð."

msgid "Step 2: GLPI Authentication Preparation"
msgstr "Skref 2: GLPI Authentication Undirbúningur"

msgid ""
"Go to <strong>APIs &amp; Services &gt; OAuth consent screen</strong> and "
"configure your app (add the scopes <code>email</code>, <code>profile</code>,"
" and <code>openid</code>)."
msgstr ""
"Farðu í <strong>API &amp; Þjónusta &gt; OAuth samþykkisskjár</strong> og "
"stilltu forritið þitt (bættu við <code>netfangi</code>, <code>prófíl</code> "
"og <code>openid</code>)."

msgid "In GLPI, go to <strong>Setup &gt; Authentication &gt; Setup</strong>."
msgstr ""
"Í GLPI, farðu í <strong>Uppsetning &gt; Auðkenning &gt; Uppsetning</strong>."

msgid ""
"Under <strong>Authorized redirect URIs</strong>, copy and paste exactly the "
"return URL below:"
msgstr ""
"Afritaðu og límdu nákvæmlega skilavefslóðina hér að neðan undir "
"<strong>Heimiluð tilvísunarvefslóð</strong>:"

msgid ""
"Subdomains are also accepted. E.g.: \"company.com\" will allow "
"user@company.com and user@sub.company.com."
msgstr ""
"Undirlén eru einnig samþykkt. T.d.: \"company.com\" mun leyfa "
"user@company.com og user@sub.company.com."

msgid ""
"To test the account creation rules and discover which Profile/Entity will be"
" assigned to an email,"
msgstr ""
"Til að prófa reglurnar um stofnun reiknings og uppgötva hvaða prófíl/eining "
"verður úthlutað á tölvupóst,"

msgid ""
"The plugin calls <code>Session::init()</code>. The GLPI core loads the "
"user\\'s profiles and starts the session. The user is redirected to the "
"dashboard."
msgstr ""
"Viðbótin kallar á <code>Session::init()</code>. GLPI kjarninn hleður "
"prófílum notandans og byrjar lotuna. Notandanum er vísað á stjórnborðið."

msgid "Error Creating Account"
msgstr "Villa við að búa til reikning"

msgid "No Profile Configured"
msgstr "Enginn prófíll stilltur"

msgid "Database Search"
msgstr "Gagnagrunnsleit"

msgid "Do you wish to proceed and create your account now?"
msgstr "Viltu halda áfram og búa til reikninginn þinn núna?"

msgid "click here"
msgstr "smelltu hér"

msgid "Auto Creation Disabled"
msgstr "Sjálfvirk sköpun óvirk"

msgid "Rules Simulator"
msgstr "Regluhermir"

msgid ""
"The system would log into the existing account <strong>%s</strong> (ID: %d)."
" No new account would be created."
msgstr ""
"Kerfið myndi skrá sig inn á núverandi reikning <strong>%s</strong> "
"(auðkenni: %d). Enginn nýr reikningur yrði stofnaður."

msgid "▶️ Simulate Login"
msgstr "▶️ Herma eftir innskráningu"

msgid ""
"Extracted domain: <strong>@%s</strong>. Applied rule: <strong>%s</strong>"
msgstr "Útdráttur lén: <strong>@%s</strong>. Notuð regla: <strong>%s</strong>"

msgid "Configuration Read"
msgstr "Stillingar Lesa"

msgid "User \"%s\" already exists. Login would be performed successfully."
msgstr ""
"Notandinn \"%s\" er þegar til. Innskráning yrði framkvæmd með góðum árangri."

msgid ""
"The email domain \"<strong>%s</strong>\" is not allowed. The plugin "
"restricts access to the domain \"<strong>%s</strong>\" or its subdomains."
msgstr ""
"Tölvupóstlénið \"<strong>%s</strong>\" er ekki leyft. Viðbótin takmarkar "
"aðgang að léninu \"<strong>%s</strong>\" eða undirlénum þess."

msgid ""
"The plugin calls <code>User::add()</code> to create the user "
"\"<strong>%s</strong>\"."
msgstr ""
"Viðbótin kallar á <code>Notanda::add()</code> til að búa til notandann "
"\"<strong>%s</strong>\"."

msgid "using the primary email:"
msgstr "með því að nota aðalnetfangið:"

msgid "User::add() called"
msgstr "Notandi::add() kallaður"

msgid "Profile Determined by Plugin"
msgstr "Prófíll ákvarðað af viðbótinni"

msgid ""
"Profile: <strong>%s</strong> (ID: %d) | Entity: <strong>%s</strong> (ID: %d)"
msgstr ""
"Prófíll: <strong>%s</strong> (auðkenni: %d) | Eining: <strong>%s</strong> "
"(auðkenni: %d)"

msgid ""
"The email domain \"<strong>%s</strong>\" is allowed by the restriction rule."
msgstr ""
"Tölvupóstlénið \"<strong>%s</strong>\" er leyft samkvæmt "
"takmörkunarreglunni."

msgid "Core Default Profile Assigned"
msgstr "Sjálfgefið kjarnasnið úthlutað"

msgid "Verified email present: <strong>%s</strong>"
msgstr "Staðfest netfang til staðar: <strong>%s</strong>"

msgid "The user \"%s\" DOES NOT exist and auto-creation is disabled."
msgstr "Notandinn \"%s\" ER EKKI til og sjálfvirk sköpun er óvirk."

msgid "Profile Correction by Plugin"
msgstr "Prófílleiðrétting með viðbót"

msgid "Yes"
msgstr "Já"

msgid "To access the system via Google, a new account will be created for"
msgstr ""
"Til að fá aðgang að kerfinu í gegnum Google verður nýr reikningur stofnaður "
"fyrir"

msgid "Rule Used"
msgstr "Regla notuð"

msgid "Plugin googlesso step"
msgstr "Plugin googlesso skref"

msgid "Simulator:"
msgstr "Hermir:"

msgid "Account Creation Required"
msgstr "Stofnun reiknings krafist"

msgid "Domain Rule for \"%s\""
msgstr "Lénsregla fyrir „%s“"

msgid ""
"This simulator faithfully reproduces the entire execution chain — from the "
"plugin logic to the internal GLPI Core behavior. Enter an email and see "
"step-by-step what would happen in a real login."
msgstr ""
"Þessi hermir endurskapar alla framkvæmdarkeðjuna af trúmennsku - frá "
"rökfræði viðbótarinnar til innri GLPI Core hegðunar. Sláðu inn tölvupóst og "
"sjáðu skref fyrir skref hvað myndi gerast í raunverulegri innskráningu."

msgid "Back to configuration"
msgstr "Aftur í stillingar"

msgid "Account Creation Confirmation"
msgstr "Staðfesting á stofnun reiknings"

msgid "Domain Rules"
msgstr "Lénsreglur"

msgid "Account Creation Simulator"
msgstr "Reikningsgerð hermir"

msgid "No"
msgstr "Nei"

msgid "No user found with the email <strong>%s</strong>"
msgstr "Enginn notandi fannst með netfangið <strong>%s</strong>"

msgid "Login / Email"
msgstr "Innskráning / tölvupóstur"

msgid ""
"The \"Automatically create users\" configuration is "
"<strong>DISABLED</strong>. The login would be blocked."
msgstr ""
"Stillingin „Búa til notendur sjálfkrafa“ er <strong>Óvirkjuð</strong>. Lokað"
" yrði fyrir innskráningu."

msgid "(none)"
msgstr "(engin)"

msgid "Login blocked: Only accounts from the %s domain are accepted."
msgstr ""
"Lokað fyrir innskráningu: Aðeins reikningar frá %s léninu eru samþykktir."

msgid "The user \"%s\" would be created successfully."
msgstr "Notandinn \"%s\" yrði búinn til."

msgid ""
"The plugin removes the incorrect profiles assigned by GLPI and explicitly "
"links the profile <strong>%s</strong> and entity <strong>%s</strong> using "
"the <code>Profile_User</code> class."
msgstr ""
"Viðbótin fjarlægir röng snið sem úthlutað er af GLPI og tengir sniðið "
"<strong>%s</strong> og eininguna <strong>%s</strong> sérstaklega með því að "
"nota <code>Profile_User</code> flokkinn."

msgid "Email Validation"
msgstr "Staðfesting tölvupósts"

msgid "User found by email: <strong>%s</strong> (ID: %d)"
msgstr "Notandi fannst með tölvupósti: <strong>%s</strong> (auðkenni: %d)"

msgid "Domain Restriction Check"
msgstr "Athugun á lénstakmörkunum"

msgid "None"
msgstr "Engin"

msgid "Session::init() — Login Performed"
msgstr "Session::init() — Innskráning framkvæmd"

msgid "Execution Chain (Step-by-Step)"
msgstr "Framkvæmdakeðja (skref fyrir skref)"

msgid "Login to Existing Account"
msgstr "Skráðu þig inn á núverandi reikning"

msgid "How it works:"
msgstr "Hvernig það virkar:"

msgid ""
"In GLPI 11, the core ignores the profile passed by external authentications "
"and automatically assigns the global default profile (usually Self-Service) "
"to the new user."
msgstr ""
"Í GLPI 11 hunsar kjarninn prófílinn sem utanaðkomandi auðkenning sendir og "
"úthlutar sjálfkrafa alþjóðlegu sjálfgefnu prófílnum (venjulega "
"sjálfsafgreiðslu) til nýja notandans."

msgid "Final Entity"
msgstr "Endanleg eining"

msgid "Final Result"
msgstr "Lokaniðurstaða"

msgid "Back to Login"
msgstr "Aftur í Innskráning"

msgid "Simulated Email:"
msgstr "Hermt netfang:"

msgid ""
"Restrict domain: <strong>%s</strong> | Auto create users: "
"<strong>%s</strong>"
msgstr ""
"Takmarka lén: <strong>%s</strong> | Búa til notendur sjálfkrafa: "
"<strong>%s</strong>"

msgid "Final Profile"
msgstr "Lokasnið"

msgid ""
"The user \"%s\" would be created, but without ANY profile. Access to GLPI "
"would be denied. Please configure a valid profile in the Default Rule or "
"Domain Rules."
msgstr ""
"Notandinn \"%s\" yrði búinn til, en án NEITT snið. Aðgangi að GLPI yrði "
"meinaður. Vinsamlega stilltu gilt snið í sjálfgefna reglunni eða "
"lénsreglunum."

msgid "GLPI Core step"
msgstr "GLPI Core skref"

msgid ""
"No valid profile (ID > 0) was found in the plugin rules. The user would be "
"created WITHOUT a profile."
msgstr ""
"Enginn gildur prófílur (auðkenni > 0) fannst í reglum viðbótarinnar. "
"Notandinn yrði búinn til ÁN prófíls."
