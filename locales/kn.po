msgstr "ಪರಿಶೀಲಿಸಿದ ಇಮೇಲ್ ಪ್ರಸ್ತುತ: <strong>%s</strong>"

msgid "The user \"%s\" DOES NOT exist and auto-creation is disabled."
msgstr ""
"ಬಳಕೆದಾರ \"%s\" ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ ಮತ್ತು ಸ್ವಯಂ ರಚನೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ."

msgid "Profile Correction by Plugin"
msgstr "ಪ್ಲಗಿನ್ ಮೂಲಕ ಪ್ರೊಫೈಲ್ ತಿದ್ದುಪಡಿ"

msgid "Yes"
msgstr "ಹೌದು"

msgid "To access the system via Google, a new account will be created for"
msgstr ""
"Google ಮೂಲಕ ಸಿಸ್ಟಮ್ ಅನ್ನು ಪ್ರವೇಶಿಸಲು, ಇದಕ್ಕಾಗಿ ಹೊಸ ಖಾತೆಯನ್ನು ರಚಿಸಲಾಗುತ್ತದೆ"

msgid "Rule Used"
msgstr "ನಿಯಮವನ್ನು ಬಳಸಲಾಗಿದೆ"

msgid "Plugin googlesso step"
msgstr "ಪ್ಲಗಿನ್ googlesso ಹಂತ"

msgid "Simulator:"
msgstr "ಸಿಮ್ಯುಲೇಟರ್:"

msgid "Account Creation Required"
msgstr "ಖಾತೆ ರಚನೆ ಅಗತ್ಯವಿದೆ"

msgid "Domain Rule for \"%s\""
msgstr "\"%s\" ಗಾಗಿ ಡೊಮೇನ್ ನಿಯಮ"

msgid ""
"This simulator faithfully reproduces the entire execution chain — from the "
"plugin logic to the internal GLPI Core behavior. Enter an email and see "
"step-by-step what would happen in a real login."
msgstr ""
"ಈ ಸಿಮ್ಯುಲೇಟರ್ ಸಂಪೂರ್ಣ ಎಕ್ಸಿಕ್ಯೂಶನ್ ಚೈನ್ ಅನ್ನು ನಿಷ್ಠೆಯಿಂದ ಪುನರುತ್ಪಾದಿಸುತ್ತದೆ "
"- ಪ್ಲಗಿನ್ ಲಾಜಿಕ್‌ನಿಂದ ಆಂತರಿಕ GLPI ಕೋರ್ ನಡವಳಿಕೆಯವರೆಗೆ. ಇಮೇಲ್ ಅನ್ನು ನಮೂದಿಸಿ "
"ಮತ್ತು ನಿಜವಾದ ಲಾಗಿನ್‌ನಲ್ಲಿ ಏನಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ಹಂತ-ಹಂತವಾಗಿ ನೋಡಿ."

msgid "Back to configuration"
msgstr "ಸಂರಚನೆಗೆ ಹಿಂತಿರುಗಿ"

msgid "Account Creation Confirmation"
msgstr "ಖಾತೆ ರಚನೆ ದೃಢೀಕರಣ"

msgid "Domain Rules"
msgstr "ಡೊಮೇನ್ ನಿಯಮಗಳು"

msgid "Account Creation Simulator"
msgstr "ಖಾತೆ ರಚನೆ ಸಿಮ್ಯುಲೇಟರ್"

msgid "No"
msgstr "ಸಂ"

msgid "No user found with the email <strong>%s</strong>"
msgstr "ಇಮೇಲ್ <strong>%s</strong> ಜೊತೆಗೆ ಯಾವುದೇ ಬಳಕೆದಾರರು ಕಂಡುಬಂದಿಲ್ಲ"

msgid "Login / Email"
msgstr "ಲಾಗಿನ್ / ಇಮೇಲ್"

msgid ""
"The \"Automatically create users\" configuration is "
"<strong>DISABLED</strong>. The login would be blocked."
msgstr ""
"\"ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬಳಕೆದಾರರನ್ನು ರಚಿಸಿ\" ಕಾನ್ಫಿಗರೇಶನ್ "
"<strong>ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ</strong>. ಲಾಗಿನ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗುವುದು."

msgid "(none)"
msgstr "(ಯಾವುದೂ ಇಲ್ಲ)"

msgid "Login blocked: Only accounts from the %s domain are accepted."
msgstr ""
"ಲಾಗಿನ್ ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ: %s ಡೊಮೇನ್‌ನಿಂದ ಖಾತೆಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸಲಾಗುತ್ತದೆ."

msgid "The user \"%s\" would be created successfully."
msgstr "ಬಳಕೆದಾರ \"%s\" ಅನ್ನು ಯಶಸ್ವಿಯಾಗಿ ರಚಿಸಲಾಗುವುದು."

msgid ""
"The plugin removes the incorrect profiles assigned by GLPI and explicitly "
"links the profile <strong>%s</strong> and entity <strong>%s</strong> using "
"the <code>Profile_User</code> class."
msgstr ""
"ಪ್ಲಗಿನ್ GLPI ನಿಂದ ನಿಯೋಜಿಸಲಾದ ತಪ್ಪಾದ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ ಮತ್ತು "
"<code>Profile_User</code> ವರ್ಗವನ್ನು ಬಳಸಿಕೊಂಡು ಪ್ರೊಫೈಲ್ <strong>%s</strong> "
"ಮತ್ತು <strong>%s</strong> ಘಟಕವನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಲಿಂಕ್ ಮಾಡುತ್ತದೆ."

msgid "Email Validation"
msgstr "ಇಮೇಲ್ ಮೌಲ್ಯೀಕರಣ"

msgid "User found by email: <strong>%s</strong> (ID: %d)"
msgstr "ಇಮೇಲ್ ಮೂಲಕ ಬಳಕೆದಾರರು ಕಂಡುಬಂದಿದ್ದಾರೆ: <strong>%s</strong> (ID: %d)"

msgid "Domain Restriction Check"
msgstr "ಡೊಮೇನ್ ನಿರ್ಬಂಧ ಪರಿಶೀಲನೆ"

msgid "None"
msgstr "ಯಾವುದೂ ಇಲ್ಲ"

msgid "Session::init() — Login Performed"
msgstr "ಸೆಷನ್::init() — ಲಾಗಿನ್ ಮಾಡಲಾಗಿದೆ"

msgid "Execution Chain (Step-by-Step)"
msgstr "ಎಕ್ಸಿಕ್ಯೂಶನ್ ಚೈನ್ (ಹಂತ-ಹಂತ)"

msgid "Login to Existing Account"
msgstr "ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಖಾತೆಗೆ ಲಾಗಿನ್ ಮಾಡಿ"

msgid "How it works:"
msgstr "ಇದು ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ:"

msgid ""
"In GLPI 11, the core ignores the profile passed by external authentications "
"and automatically assigns the global default profile (usually Self-Service) "
"to the new user."
msgstr ""
"GLPI 11 ರಲ್ಲಿ, ಕೋರ್ ಬಾಹ್ಯ ದೃಢೀಕರಣಗಳಿಂದ ರವಾನಿಸಲಾದ ಪ್ರೊಫೈಲ್ ಅನ್ನು "
"ನಿರ್ಲಕ್ಷಿಸುತ್ತದೆ ಮತ್ತು ಹೊಸ ಬಳಕೆದಾರರಿಗೆ ಜಾಗತಿಕ ಡೀಫಾಲ್ಟ್ ಪ್ರೊಫೈಲ್ ಅನ್ನು "
"(ಸಾಮಾನ್ಯವಾಗಿ ಸ್ವಯಂ-ಸೇವೆ) ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನಿಯೋಜಿಸುತ್ತದೆ."

msgid "Final Entity"
msgstr "ಅಂತಿಮ ಘಟಕ"

msgid "Final Result"
msgstr "ಅಂತಿಮ ಫಲಿತಾಂಶ"

msgid "Back to Login"
msgstr "ಲಾಗಿನ್ ಗೆ ಹಿಂತಿರುಗಿ"

msgid "Simulated Email:"
msgstr "ಅನುಕರಿಸಿದ ಇಮೇಲ್:"

msgid ""
"Restrict domain: <strong>%s</strong> | Auto create users: "
"<strong>%s</strong>"
msgstr ""
"ಡೊಮೇನ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿ: <strong>%s</strong> | ಸ್ವಯಂ ರಚಿಸಿ ಬಳಕೆದಾರರು: "
"<strong>%s</strong>"

msgid "Final Profile"
msgstr "ಅಂತಿಮ ಪ್ರೊಫೈಲ್"

msgid ""
"The user \"%s\" would be created, but without ANY profile. Access to GLPI "
"would be denied. Please configure a valid profile in the Default Rule or "
"Domain Rules."
msgstr ""
"ಬಳಕೆದಾರ \"%s\" ಅನ್ನು ರಚಿಸಲಾಗುವುದು, ಆದರೆ ಯಾವುದೇ ಪ್ರೊಫೈಲ್ ಇಲ್ಲದೆ. GLPI ಗೆ "
"ಪ್ರವೇಶವನ್ನು ನಿರಾಕರಿಸಲಾಗುವುದು. ದಯವಿಟ್ಟು ಡೀಫಾಲ್ಟ್ ನಿಯಮ ಅಥವಾ ಡೊಮೇನ್ ನಿಯಮಗಳಲ್ಲಿ "
"ಮಾನ್ಯವಾದ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿ."

msgid "GLPI Core step"
msgstr "GLPI ಕೋರ್ ಹಂತ"

msgid ""
"No valid profile (ID > 0) was found in the plugin rules. The user would be "
"created WITHOUT a profile."
msgstr ""
"ಪ್ಲಗಿನ್ ನಿಯಮಗಳಲ್ಲಿ ಯಾವುದೇ ಮಾನ್ಯವಾದ ಪ್ರೊಫೈಲ್ (ID > 0) ಕಂಡುಬಂದಿಲ್ಲ. ಪ್ರೊಫೈಲ್ "
"ಇಲ್ಲದೆಯೇ ಬಳಕೆದಾರರನ್ನು ರಚಿಸಲಾಗುವುದು."
