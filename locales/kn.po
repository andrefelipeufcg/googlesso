msgid ""
"The plugin calls <code>User::add()</code> to create the user "
"\"<strong>%s</strong>\"."
msgstr ""
"\"<strong>%s</strong>\" ಬಳಕೆದಾರರನ್ನು ರಚಿಸಲು ಪ್ಲಗಿನ್ <code>User::add()</code>"
" ಅನ್ನು ಕರೆಯುತ್ತದೆ."

msgid "using the primary email:"
msgstr "ಪ್ರಾಥಮಿಕ ಇಮೇಲ್ ಬಳಸಿ:"

msgid "User::add() called"
msgstr "ಬಳಕೆದಾರ:: add() ಎಂದು ಕರೆಯಲಾಗಿದೆ"

msgid "Profile Determined by Plugin"
msgstr "ಪ್ರೊಫೈಲ್ ಅನ್ನು ಪ್ಲಗಿನ್ ಮೂಲಕ ನಿರ್ಧರಿಸಲಾಗುತ್ತದೆ"

msgid ""
"Profile: <strong>%s</strong> (ID: %d) | Entity: <strong>%s</strong> (ID: %d)"
msgstr ""
"ಪ್ರೊಫೈಲ್: <strong>%s</strong> (ID: %d) | ಅಸ್ತಿತ್ವ: <strong>%s</strong> (ID: "
"%d)"

msgid ""
"The email domain \"<strong>%s</strong>\" is allowed by the restriction rule."
msgstr ""
"\"<strong>%s</strong>\" ಇಮೇಲ್ ಡೊಮೇನ್ ಅನ್ನು ನಿರ್ಬಂಧದ ನಿಯಮದಿಂದ ಅನುಮತಿಸಲಾಗಿದೆ."

