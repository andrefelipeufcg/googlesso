msgstr "ನೀವು ಇದೀಗ ಮುಂದುವರಿಯಲು ಮತ್ತು ನಿಮ್ಮ ಖಾತೆಯನ್ನು ರಚಿಸಲು ಬಯಸುವಿರಾ?"

msgid "click here"
msgstr "ಇಲ್ಲಿ ಕ್ಲಿಕ್ ಮಾಡಿ"

