#
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Add Rule"
msgstr "Дүрэм Нэмэх"

msgid ""
"Add rules to define which profile and entity the user will receive based on "
"their email domain (Optional)."
msgstr ""
"Хэрэглэгчийн имэйл домэйноос хамаарч ямар профайл болон байгууллагыг авахыг "
"тодорхойлох дүрмүүд нэмнэ үү (Сонголттой)."

msgid "Automatically create users on first login"
msgstr "Анх нэвтрэхэд хэрэглэгчдийг автоматаар үүсгэх"

msgid "Configuration updated."
msgstr "Тохиргоог шинэчиллээ."

msgid "Default Rule (Fallback)"
msgstr "Анхдагч Дүрэм (Нөөц)"

msgid "Default entity (ELSE)"
msgstr "Анхдагч байгууллага (ҮГҮЙ БОЛ)"

msgid "Default profile (ELSE)"
msgstr "Анхдагч профайл (ҮГҮЙ БОЛ)"

msgid "Domain (after @)"
msgstr "Домэйн (@ тэмдгийн дараах)"

msgid "Entity"
msgstr "Байгууллага"

msgid "Failed to create the user in GLPI."
msgstr "GLPI дээр хэрэглэгчийг үүсгэхэд алдаа гарлаа."

msgid "Google SSO"
msgstr "Google SSO"

msgid "Google SSO — Configuration"
msgstr "Google SSO — Тохиргоо"

msgid "Google authentication failed: %s"
msgstr "Google баталгаажуулалт амжилтгүй боллоо: %s"

msgid "Google login cancelled: %s"
msgstr "Google нэвтрэлтийг цуцалсан: %s"

msgid "Google response without authorization code."
msgstr "Баталгаажуулах кодгүй Google-н хариу."

msgid ""
"If the user email does not match any of the rules above, this profile and "
"entity will be used. Mandatory if automatic creation is enabled."
msgstr ""
"Хэрвээ хэрэглэгчийн имэйл дээрх дүрмүүдийн аль нэгэнд нь тохирохгүй бол энэ "
"профайл болон байгууллагыг ашиглана. Автоматаар үүсгэх тохиргоо идэвхжсэн "
"үед заавал шаардлагатай."

msgid "Invalid OAuth2 state. Try again from the login page."
msgstr "OAuth2 төлөв буруу байна. Нэвтрэх хуудаснаас дахин оролдоно уу."

msgid "Leave blank to keep current secret (stored encrypted)."
msgstr ""
"Одоогийн нууцыг хадгалахын тулд (шифрлэгдсэн хэлбэрээр хадгалагддаг) хоосон "
"орхино уу."

msgid "No GLPI user corresponds to this Google account."
msgstr "Энэ Google бүртгэлд тохирох GLPI хэрэглэгч алга байна."

msgid "Only accounts from the %s domain are accepted."
msgstr "Зөвхөн %s домэйны бүртгэлүүдийг хүлээн зөвшөөрнө."

msgid "Profile"
msgstr "Профайл"

msgid "Profile and Entity Rules by Domain"
msgstr "Домэйны дагуу Профайл ба Байгууллагын дүрэм"

msgid "Register this Redirect URI in Google Cloud Console:"
msgstr "Энэхүү шилжүүлэх URI-г Google Cloud Console-д бүртгүүлнэ үү:"

msgid "Restrict to domain (optional)"
msgstr "Домэйноор хязгаарлах (Сонголттой)"

msgid "Save"
msgstr "Хадгалах"

msgid "Select..."
msgstr "Сонгох..."

msgid "Session not initialized: user has no enabled profile."
msgstr "Сесс эхлээгүй байна: хэрэглэгч идэвхжүүлсэн профайлгүй байна."

msgid "Sign in with Google"
msgstr "Google-ээр нэвтрэх"

msgid "The Google account does not have a verified email."
msgstr "Google бүртгэл баталгаажсан имэйлгүй байна."

msgid "This user is deactivated in GLPI."
msgstr "Энэ хэрэглэгчийг GLPI дээр идэвхгүй болгосон байна."

msgid "or"
msgstr "эсвэл"

msgid ""
"Leave the option <strong>\"Remove domain of logins in form "
"login@domain\"</strong> as <strong>No</strong>. If enabled, users with the "
"same prefix in different providers (e.g., admin@gmail.com and "
"admin@institution.edu.br) will suffer account overlap."
msgstr ""
"<strong>\"login@domain маягтын нэвтрэх домэйныг устгах\"</strong> сонголтыг "
"<strong>Үгүй</strong> гэж үлдээгээрэй. Идэвхжүүлсэн тохиолдолд өөр үйлчилгээ"
" үзүүлэгчийн ижил угтвартай хэрэглэгчид (жишээ нь, admin@gmail.com болон "
"admin@institution.edu.br) бүртгэл давхцах болно."

msgid ""
"Check the <strong>Activate \"Sign in with Google\" button</strong> option "
"below and click <strong>Save</strong>."
msgstr ""
"Доорх <strong>\"Google-ээр нэвтрэх\" товчийг идэвхжүүлэх</strong> сонголтыг "
"шалгаад <strong>Хадгалах</strong> дээр дарна уу."

msgid ""
"Change the <strong>Automatically add users from an external authentication "
"source</strong> field to <strong>Yes</strong>."
msgstr ""
"<strong>Гадаад баталгаажуулалтын эх сурвалжаас хэрэглэгчдийг автоматаар "
"нэмэх</strong> талбарыг <strong>Тийм</strong> болгож өөрчил."

msgid "Step 1: Google Cloud Preparation"
msgstr "Алхам 1: Google Cloud бэлтгэх"

msgid "Critical Warning:"
msgstr "Чухал сэрэмжлүүлэг:"

msgid "How to enable Google SSO integration?"
msgstr "Google SSO интеграцийг хэрхэн идэвхжүүлэх вэ?"

msgid ""
"Google will generate a <strong>Client ID</strong> and a <strong>Client "
"Secret</strong>. Fill in the fields in this form with those keys."
msgstr ""
"Google нь <strong>Үйлчлүүлэгчийн ID</strong> болон <strong>Үйлчлүүлэгчийн "
"нууц</strong> үүсгэх болно. Эдгээр түлхүүрүүдээр энэ маягтын талбаруудыг "
"бөглөнө үү."

msgid ""
"Access the <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a> and create a new "
"<strong>Project</strong>."
msgstr ""
"<a href=\"https://console.cloud.google.com/\" target=\"_blank\">Google Cloud"
" Console</a> руу нэвтэрч, шинэ <strong>Төсөл</strong> үүсгэнэ үү."

msgid "Redirect URI:"
msgstr "URI дахин чиглүүлэх:"

msgid "Activate \"Sign in with Google\" button"
msgstr "\"Google-ээр нэвтрэх\" товчийг идэвхжүүлнэ үү"

msgid ""
"Then go to <strong>Credentials &gt; Create Credentials &gt; OAuth client "
"ID</strong>, choosing the <strong>Web application</strong> type."
msgstr ""
"Дараа нь<strong>Итгэмжлэл &gt; Итгэмжлэл үүсгэх &gt; OAuth клиент "
"ID</strong>, <strong>Вэб програм</strong>-ын төрлийг сонгоно."

msgid "Step 2: GLPI Authentication Preparation"
msgstr "Алхам 2: GLPI баталгаажуулалтын бэлтгэл"

msgid ""
"Go to <strong>APIs &amp; Services &gt; OAuth consent screen</strong> and "
"configure your app (add the scopes <code>email</code>, <code>profile</code>,"
" and <code>openid</code>)."
msgstr ""
"<strong>API &amp; Үйлчилгээ &gt; OAuth зөвшөөрлийн дэлгэц</strong> болон "
"өөрийн програмыг тохируулна уу (<code>email</code>, <code>profile</code> "
"болон <code>openid</code> хүрээг нэмнэ үү)."

msgid "In GLPI, go to <strong>Setup &gt; Authentication &gt; Setup</strong>."
msgstr ""
"GLPI-д <strong>Тохиргоо &gt; Баталгаажуулалт &gt; Тохируулга</strong>."

msgid ""
"Under <strong>Authorized redirect URIs</strong>, copy and paste exactly the "
"return URL below:"
msgstr ""
"<strong>Эрх бүхий дахин чиглүүлэх URI</strong>-н доор яг буцах URL-г хуулж "
"буулгана уу:"

msgid ""
"Subdomains are also accepted. E.g.: \"company.com\" will allow "
"user@company.com and user@sub.company.com."
msgstr ""
"Дэд домайнуудыг мөн хүлээн зөвшөөрдөг. Жнь: \"company.com\" нь "
"user@company.com болон user@sub.company.com-г зөвшөөрнө."

msgid ""
"To test the account creation rules and discover which Profile/Entity will be"
" assigned to an email,"
msgstr ""
"Бүртгэл үүсгэх дүрмийг туршиж үзэхийн тулд аль профайл/байгууллага нь имэйлд"
" хуваарилагдахыг олж мэдэхийн тулд,"

msgid ""
"The plugin calls <code>Session::init()</code>. The GLPI core loads the "
"user\\'s profiles and starts the session. The user is redirected to the "
"dashboard."
msgstr ""
"Plugin нь <code>Session::init()</code>-г дууддаг. GLPI цөм нь хэрэглэгчийн "
"профайлыг ачаалж, сессийг эхлүүлдэг. Хэрэглэгчийг хяналтын самбар руу "
"шилжүүлнэ."

msgid "Error Creating Account"
msgstr "Бүртгэл үүсгэхэд алдаа гарлаа"

msgid "No Profile Configured"
msgstr "Профайл тохируулаагүй байна"

msgid "Database Search"
msgstr "Өгөгдлийн сангийн хайлт"

msgid "Do you wish to proceed and create your account now?"
msgstr "Та одоо үргэлжлүүлж, бүртгэлээ үүсгэмээр байна уу?"

msgid "click here"
msgstr "энд дарна уу"

msgid "Auto Creation Disabled"
msgstr "Автомат үүсгэхийг идэвхгүй болгосон"

msgid "Rules Simulator"
msgstr "Дүрмийн симулятор"

msgid ""
"The system would log into the existing account <strong>%s</strong> (ID: %d)."
" No new account would be created."
msgstr ""
"Систем одоо байгаа <strong>%s</strong> (ID: %d) бүртгэл рүү нэвтэрнэ. Шинэ "
"данс үүсгэхгүй."

msgid "▶️ Simulate Login"
msgstr "▶️ Нэвтрэхийг дуурай"

msgid ""
"Extracted domain: <strong>@%s</strong>. Applied rule: <strong>%s</strong>"
msgstr ""
"Татаж авсан домэйн: <strong>@%s</strong>. Хэрэглэсэн дүрэм: "
"<strong>%s</strong>"

msgid "Configuration Read"
msgstr "Тохиргоог уншина уу"

msgid "User \"%s\" already exists. Login would be performed successfully."
msgstr ""
"\"%s\" хэрэглэгч аль хэдийн байна. Нэвтрэх ажиллагааг амжилттай хийх болно."

msgid ""
"The email domain \"<strong>%s</strong>\" is not allowed. The plugin "
"restricts access to the domain \"<strong>%s</strong>\" or its subdomains."
msgstr ""
"\"<strong>%s</strong>\" имэйл домайныг зөвшөөрөхгүй. Энэхүү залгаас нь "
"\"<strong>%s</strong>\" домайн эсвэл түүний дэд домайнуудад хандах хандалтыг"
" хязгаарладаг."

msgid ""
"The plugin calls <code>User::add()</code> to create the user "
"\"<strong>%s</strong>\"."
msgstr ""
"Plugin нь \"<strong>%s</strong>\" хэрэглэгчийг үүсгэхийн тулд "
"<code>User::add()</code>-г дууддаг."

msgid "using the primary email:"
msgstr "үндсэн имэйлийг ашиглан:"

msgid "User::add() called"
msgstr "Хэрэглэгч::add() гэж дуудсан"

msgid "Profile Determined by Plugin"
msgstr "Профайлыг залгаасаар тодорхойлсон"

msgid ""
"Profile: <strong>%s</strong> (ID: %d) | Entity: <strong>%s</strong> (ID: %d)"
msgstr ""
"Профайл: <strong>%s</strong> (ID: %d) | Аж ахуйн нэгж: <strong>%s</strong> "
"(ID: %d)"

msgid ""
"The email domain \"<strong>%s</strong>\" is allowed by the restriction rule."
msgstr "Хязгаарлалтын дүрмээр \"<strong>%s</strong>\" имэйл домэйныг зөвшөөрдөг."

msgid "Core Default Profile Assigned"
msgstr "Үндсэн өгөгдмөл профайлыг томилсон"

msgid "Verified email present: <strong>%s</strong>"
msgstr "Баталгаажсан имэйл байна: <strong>%s</strong>"

msgid "The user \"%s\" DOES NOT exist and auto-creation is disabled."
msgstr "\"%s\" хэрэглэгч БАЙДАГГҮЙ ба автоматаар үүсгэхийг идэвхгүй болгосон."

msgid "Profile Correction by Plugin"
msgstr "Plugin ашиглан профайлыг засах"

msgid "Yes"
msgstr "Тиймээ"

msgid "To access the system via Google, a new account will be created for"
msgstr "Google-ээр дамжуулан системд нэвтрэхийн тулд шинэ бүртгэл үүсгэнэ"

msgid "Rule Used"
msgstr "Ашигласан дүрэм"

msgid "Plugin googlesso step"
msgstr "Google залгаас хийх алхам"

msgid "Simulator:"
msgstr "Симулятор:"

msgid "Account Creation Required"
msgstr "Бүртгэл үүсгэх шаардлагатай"

msgid "Domain Rule for \"%s\""
msgstr "\"%s\"-н домайн дүрэм"

msgid ""
"This simulator faithfully reproduces the entire execution chain — from the "
"plugin logic to the internal GLPI Core behavior. Enter an email and see "
"step-by-step what would happen in a real login."
msgstr ""
"Энэхүү симулятор нь залгаасын логикоос эхлээд GLPI Core-ийн дотоод үйл "
"ажиллагаа хүртэл гүйцэтгэх гинжийг бүхэлд нь үнэнчээр хуулбарладаг. Имэйлээ "
"оруулаад, жинхэнэ нэвтрэхэд юу тохиолдохыг алхам алхмаар хараарай."

msgid "Back to configuration"
msgstr "Тохиргоо руу буцах"

msgid "Account Creation Confirmation"
msgstr "Бүртгэл үүсгэх баталгаажуулалт"

msgid "Domain Rules"
msgstr "Домэйн дүрэм"

msgid "Account Creation Simulator"
msgstr "Бүртгэл үүсгэх симулятор"

msgid "No"
msgstr "Үгүй"

msgid "No user found with the email <strong>%s</strong>"
msgstr "<strong>%s</strong> имэйлтэй хэрэглэгч олдсонгүй"

msgid "Login / Email"
msgstr "Нэвтрэх / Имэйл"

msgid ""
"The \"Automatically create users\" configuration is "
"<strong>DISABLED</strong>. The login would be blocked."
msgstr ""
"\"Хэрэглэгчдийг автоматаар үүсгэх\" тохиргоо нь <strong>ИДЭВХГҮЙ "
"БАЙДАЛТАЙ</strong> байна. Нэвтрэх нь хаагдах болно."

msgid "(none)"
msgstr "(байхгүй)"

msgid "Login blocked: Only accounts from the %s domain are accepted."
msgstr "Нэвтрэхийг хориглосон: Зөвхөн %s домэйны бүртгэлийг зөвшөөрнө."

msgid "The user \"%s\" would be created successfully."
msgstr "\"%s\" хэрэглэгчийг амжилттай үүсгэсэн."

msgid ""
"The plugin removes the incorrect profiles assigned by GLPI and explicitly "
"links the profile <strong>%s</strong> and entity <strong>%s</strong> using "
"the <code>Profile_User</code> class."
msgstr ""
"Энэхүү залгаас нь GLPI-аас өгсөн буруу профайлыг устгаж, "
"<code>Profile_User</code> анги ашиглан <strong>%s</strong> профайл болон "
"<strong>%s</strong> объектыг тодорхой холбодог."

msgid "Email Validation"
msgstr "Имэйл баталгаажуулалт"

msgid "User found by email: <strong>%s</strong> (ID: %d)"
msgstr "Хэрэглэгчийг имэйлээр олсон: <strong>%s</strong> (ID: %d)"

msgid "Domain Restriction Check"
msgstr "Домэйн хязгаарлалтын шалгалт"

msgid "None"
msgstr "Байхгүй"

msgid "Session::init() — Login Performed"
msgstr "Session::init() — Нэвтрэхийг гүйцэтгэсэн"

msgid "Execution Chain (Step-by-Step)"
msgstr "Гүйцэтгэлийн хэлхээ (Алхам алхмаар)"

msgid "Login to Existing Account"
msgstr "Одоо байгаа данс руу нэвтэрнэ үү"

msgid "How it works:"
msgstr "Энэ нь хэрхэн ажилладаг вэ:"

msgid ""
"In GLPI 11, the core ignores the profile passed by external authentications "
"and automatically assigns the global default profile (usually Self-Service) "
"to the new user."
msgstr ""
"GLPI 11-д цөм нь гадны нэвтрэлт танилтаар дамжуулсан профайлыг үл "
"тоомсорлож, шинэ хэрэглэгчдэд дэлхийн анхдагч профайлыг (ихэвчлэн Self-"
"Service) автоматаар оноодог."

msgid "Final Entity"
msgstr "Эцсийн байгууллага"

msgid "Final Result"
msgstr "Эцсийн үр дүн"

msgid "Back to Login"
msgstr "Нэвтрэх рүү буцах"

msgid "Simulated Email:"
msgstr "Загварчилсан имэйл:"

msgid ""
"Restrict domain: <strong>%s</strong> | Auto create users: "
"<strong>%s</strong>"
msgstr ""
"Домэйн хязгаарлах: <strong>%s</strong> | Хэрэглэгчдийг автоматаар үүсгэх: "
"<strong>%s</strong>"

msgid "Final Profile"
msgstr "Эцсийн профайл"

msgid ""
"The user \"%s\" would be created, but without ANY profile. Access to GLPI "
"would be denied. Please configure a valid profile in the Default Rule or "
"Domain Rules."
msgstr ""
"\"%s\" хэрэглэгч үүсгэгдэх боловч ямар ч профайл байхгүй болно. GLPI-д "
"нэвтрэх эрхийг хориглоно. Өгөгдмөл дүрэм эсвэл Домэйн дүрэмд хүчинтэй "
"профайлыг тохируулна уу."

msgid "GLPI Core step"
msgstr "GLPI үндсэн алхам"

msgid ""
"No valid profile (ID > 0) was found in the plugin rules. The user would be "
"created WITHOUT a profile."
msgstr ""
"Plugin дүрмээс хүчинтэй профайл (ID > 0) олдсонгүй. Хэрэглэгчийг "
"профайлгүйгээр үүсгэнэ."
