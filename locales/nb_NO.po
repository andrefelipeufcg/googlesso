#
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Add Rule"
msgstr "Legg til regel"

msgid ""
"Add rules to define which profile and entity the user will receive based on "
"their email domain (Optional)."
msgstr ""
"Legg til regler for å definere hvilken profil og enhet brukeren skal få "
"basert på e-postdomenet deres (valgfritt)."

msgid "Automatically create users on first login"
msgstr "Opprett brukere automatisk ved første pålogging"

msgid "Configuration updated."
msgstr "Konfigurasjonen ble oppdatert."

msgid "Default Rule (Fallback)"
msgstr "Standardregel (Reserve)"

msgid "Default entity (ELSE)"
msgstr "Standardenhet (ELLERS)"

msgid "Default profile (ELSE)"
msgstr "Standardprofil (ELLERS)"

msgid "Domain (after @)"
msgstr "Domene (etter @)"

msgid "Entity"
msgstr "Enhet"

msgid "Failed to create the user in GLPI."
msgstr "Kunne ikke opprette brukeren i GLPI."

msgid "Google SSO"
msgstr "Google SSO"

msgid "Google SSO — Configuration"
msgstr "Google SSO — Konfigurasjon"

msgid "Google authentication failed: %s"
msgstr "Google-autentisering mislyktes: %s"

msgid "Google login cancelled: %s"
msgstr "Google-pålogging avbrutt: %s"

msgid "Google response without authorization code."
msgstr "Google-svar uten autorisasjonskode."

msgid ""
"If the user email does not match any of the rules above, this profile and "
"entity will be used. Mandatory if automatic creation is enabled."
msgstr ""
"Hvis brukerens e-postadresse ikke samsvarer med noen av reglene ovenfor, vil"
" denne profilen og enheten bli brukt. Obligatorisk hvis automatisk "
"oppretting er aktivert."

msgid "Invalid OAuth2 state. Try again from the login page."
msgstr "Ugyldig OAuth2-status. Prøv igjen fra påloggingssiden."

msgid "Leave blank to keep current secret (stored encrypted)."
msgstr "La stå tomt for å beholde gjeldende hemmelighet (lagres kryptert)."

msgid "No GLPI user corresponds to this Google account."
msgstr "Ingen GLPI-bruker samsvarer med denne Google-kontoen."

msgid "Only accounts from the %s domain are accepted."
msgstr "Bare kontoer fra domenet %s godtas."

msgid "Profile"
msgstr "Profil"

msgid "Profile and Entity Rules by Domain"
msgstr "Profil- og enhetsregler etter domene"

msgid "Register this Redirect URI in Google Cloud Console:"
msgstr "Registrer denne omdirigerings-URI-en i Google Cloud Console:"

msgid "Restrict to domain (optional)"
msgstr "Begrens til domene (valgfritt)"

msgid "Save"
msgstr "Lagre"

msgid "Select..."
msgstr "Velg..."

msgid "Session not initialized: user has no enabled profile."
msgstr "Økten er ikke initialisert: brukeren har ingen aktivert profil."

msgid "Sign in with Google"
msgstr "Logg på med Google"

msgid "The Google account does not have a verified email."
msgstr "Google-kontoen har ikke en bekreftet e-postadresse."

msgid "This user is deactivated in GLPI."
msgstr "Denne brukeren er deaktivert i GLPI."

msgid "or"
msgstr "eller"

msgid ""
"Leave the option <strong>\"Remove domain of logins in form "
"login@domain\"</strong> as <strong>No</strong>. If enabled, users with the "
"same prefix in different providers (e.g., admin@gmail.com and "
"admin@institution.edu.br) will suffer account overlap."
msgstr ""
"La alternativet <strong>\"Fjern domene for pålogginger i form "
"login@domain\"</strong> være <strong>Nei</strong>. Hvis aktivert, vil "
"brukere med samme prefiks i forskjellige leverandører (f.eks. "
"admin@gmail.com og admin@institution.edu.br) lide over kontooverlapping."

msgid ""
"Check the <strong>Activate \"Sign in with Google\" button</strong> option "
"below and click <strong>Save</strong>."
msgstr ""
"Merk av for <strong>Aktiver «Logg på med "
"Google»-knappen</strong>-alternativet nedenfor, og klikk på "
"<strong>Lagre</strong>."

msgid ""
"Change the <strong>Automatically add users from an external authentication "
"source</strong> field to <strong>Yes</strong>."
msgstr ""
"Endre feltet <strong>Legg til brukere automatisk fra en ekstern "
"autentiseringskilde</strong> til <strong>Ja</strong>."

msgid "Step 1: Google Cloud Preparation"
msgstr "Trinn 1: Google Cloud-forberedelse"

msgid "Critical Warning:"
msgstr "Kritisk advarsel:"

msgid "How to enable Google SSO integration?"
msgstr "Hvordan aktiverer jeg Google SSO-integrasjon?"

msgid ""
"Google will generate a <strong>Client ID</strong> and a <strong>Client "
"Secret</strong>. Fill in the fields in this form with those keys."
msgstr ""
"Google genererer en <strong>klient-ID</strong> og en "
"<strong>klienthemmelighet</strong>. Fyll ut feltene i dette skjemaet med "
"disse nøklene."

msgid ""
"Access the <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a> and create a new "
"<strong>Project</strong>."
msgstr ""
"Gå til <a href=\"https://console.cloud.google.com/\" "
"target=\"_blank\">Google Cloud Console</a> og opprett et nytt "
"<strong>prosjekt</strong>."

msgid "Redirect URI:"
msgstr "Omdirigerings-URI:"

msgid "Activate \"Sign in with Google\" button"
msgstr "Aktiver «Logg på med Google»-knappen"

msgid ""
"Then go to <strong>Credentials &gt; Create Credentials &gt; OAuth client "
"ID</strong>, choosing the <strong>Web application</strong> type."
msgstr ""
"Gå deretter til <strong>Påloggingsinformasjon &gt; Opprett legitimasjon &gt;"
" OAuth-klient-ID</strong>, ved å velge typen "
"<strong>Nettapplikasjon</strong>."

msgid "Step 2: GLPI Authentication Preparation"
msgstr "Trinn 2: Klargjøring av GLPI-autentisering"

msgid ""
"Go to <strong>APIs &amp; Services &gt; OAuth consent screen</strong> and "
"configure your app (add the scopes <code>email</code>, <code>profile</code>,"
" and <code>openid</code>)."
msgstr ""
"Gå til <strong>APIer &amp; Tjenester &gt; OAuth-samtykkeskjermen</strong> og"
" konfigurer appen din (legg til omfangene <code>e-post</code>, "
"<code>profil</code> og <code>openid</code>)."

msgid "In GLPI, go to <strong>Setup &gt; Authentication &gt; Setup</strong>."
msgstr ""
"I GLPI går du til <strong>Oppsett &gt; Autentisering &gt; Oppsett</strong>."

msgid ""
"Under <strong>Authorized redirect URIs</strong>, copy and paste exactly the "
"return URL below:"
msgstr ""
"Under <strong>Autoriserte omdirigerings-URIer</strong> kopierer og limer du "
"inn nøyaktig retur-URI-en nedenfor:"

msgid ""
"Subdomains are also accepted. E.g.: \"company.com\" will allow "
"user@company.com and user@sub.company.com."
msgstr ""
"Underdomener aksepteres også. F.eks.: \"company.com\" vil tillate "
"user@company.com og user@sub.company.com."

msgid ""
"To test the account creation rules and discover which Profile/Entity will be"
" assigned to an email,"
msgstr ""
"For å teste reglene for kontooppretting og finne ut hvilken profil/enhet som"
" vil bli tildelt en e-post,"

msgid ""
"The plugin calls <code>Session::init()</code>. The GLPI core loads the "
"user\\'s profiles and starts the session. The user is redirected to the "
"dashboard."
msgstr ""
"Programtillegget kaller <code>Session::init()</code>. GLPI-kjernen laster "
"brukerens profiler og starter økten. Brukeren blir omdirigert til "
"dashbordet."

msgid "Error Creating Account"
msgstr "Feil ved opprettelse av konto"

msgid "No Profile Configured"
msgstr "Ingen profil konfigurert"

msgid "Database Search"
msgstr "Databasesøk"

msgid "Do you wish to proceed and create your account now?"
msgstr "Ønsker du å fortsette og opprette kontoen din nå?"

msgid "click here"
msgstr "klikk her"

msgid "Auto Creation Disabled"
msgstr "Autooppretting deaktivert"

msgid "Rules Simulator"
msgstr "Regelsimulator"

msgid ""
"The system would log into the existing account <strong>%s</strong> (ID: %d)."
" No new account would be created."
msgstr ""
"Systemet vil logge på den eksisterende kontoen <strong>%s</strong> (ID: %d)."
" Ingen ny konto vil bli opprettet."

msgid "▶️ Simulate Login"
msgstr "▶️ Simuler pålogging"

msgid ""
"Extracted domain: <strong>@%s</strong>. Applied rule: <strong>%s</strong>"
msgstr ""
"Uttrukket domene: <strong>@%s</strong>. Anvendt regel: <strong>%s</strong>"

msgid "Configuration Read"
msgstr "Konfigurasjonslesing"

msgid "User \"%s\" already exists. Login would be performed successfully."
msgstr "Brukeren \"%s\" eksisterer allerede. Innlogging vil bli utført."

msgid ""
"The email domain \"<strong>%s</strong>\" is not allowed. The plugin "
"restricts access to the domain \"<strong>%s</strong>\" or its subdomains."
msgstr ""
"E-postdomenet «<strong>%s</strong>» er ikke tillatt. Programtillegget "
"begrenser tilgangen til domenet «<strong>%s</strong>» eller dets "
"underdomener."

msgid ""
"The plugin calls <code>User::add()</code> to create the user "
"\"<strong>%s</strong>\"."
msgstr ""
"Programtillegget kaller <code>User::add()</code> for å opprette brukeren "
"\"<strong>%s</strong>\"."

msgid "using the primary email:"
msgstr "ved å bruke den primære e-posten:"

msgid "User::add() called"
msgstr "Bruker::add() kalt"

msgid "Profile Determined by Plugin"
msgstr "Profil bestemt av plugin"

msgid ""
"Profile: <strong>%s</strong> (ID: %d) | Entity: <strong>%s</strong> (ID: %d)"
msgstr ""
"Profil: <strong>%s</strong> (ID: %d) | Entitet: <strong>%s</strong> (ID: %d)"

msgid ""
"The email domain \"<strong>%s</strong>\" is allowed by the restriction rule."
msgstr ""
"E-postdomenet «<strong>%s</strong>» er tillatt av restriksjonsregelen."

msgid "Core Default Profile Assigned"
msgstr "Kjernestandardprofil tilordnet"

msgid "Verified email present: <strong>%s</strong>"
msgstr "Bekreftet e-post tilstede: <strong>%s</strong>"

msgid "The user \"%s\" DOES NOT exist and auto-creation is disabled."
msgstr "Brukeren \"%s\" eksisterer IKKE og automatisk opprettelse er deaktivert."

msgid "Profile Correction by Plugin"
msgstr "Profilkorreksjon med plugin"

msgid "Yes"
msgstr "Ja"

msgid "To access the system via Google, a new account will be created for"
msgstr ""
"For å få tilgang til systemet via Google opprettes det en ny konto for"

msgid "Rule Used"
msgstr "Regel brukt"

msgid "Plugin googlesso step"
msgstr "Plugin googlesso trinn"

msgid "Simulator:"
msgstr "Simulator:"

msgid "Account Creation Required"
msgstr "Kontooppretting kreves"

msgid "Domain Rule for \"%s\""
msgstr "Domeneregel for «%s»"

msgid ""
"This simulator faithfully reproduces the entire execution chain — from the "
"plugin logic to the internal GLPI Core behavior. Enter an email and see "
"step-by-step what would happen in a real login."
msgstr ""
"Denne simulatoren gjengir trofast hele utførelseskjeden - fra plugin-"
"logikken til den interne GLPI Core-atferden. Skriv inn en e-post og se steg-"
"for-steg hva som ville skje ved en ekte pålogging."

msgid "Back to configuration"
msgstr "Tilbake til konfigurasjon"

msgid "Account Creation Confirmation"
msgstr "Kontoopprettelsesbekreftelse"

msgid "Domain Rules"
msgstr "Domeneregler"

msgid "Account Creation Simulator"
msgstr "Simulator for kontooppretting"

msgid "No"
msgstr "Ingen"

msgid "No user found with the email <strong>%s</strong>"
msgstr "Ingen bruker funnet med e-postadressen <strong>%s</strong>"

msgid "Login / Email"
msgstr "Logg inn / e-post"

msgid ""
"The \"Automatically create users\" configuration is "
"<strong>DISABLED</strong>. The login would be blocked."
msgstr ""
"«Opprett brukere automatisk»-konfigurasjonen er <strong>DEAKTIVERT</strong>."
" Innloggingen vil bli blokkert."

msgid "(none)"
msgstr "(ingen)"

msgid "Login blocked: Only accounts from the %s domain are accepted."
msgstr "Innlogging blokkert: Kun kontoer fra %s-domenet godtas."

msgid "The user \"%s\" would be created successfully."
msgstr "Brukeren \"%s\" ville blitt opprettet."

msgid ""
"The plugin removes the incorrect profiles assigned by GLPI and explicitly "
"links the profile <strong>%s</strong> and entity <strong>%s</strong> using "
"the <code>Profile_User</code> class."
msgstr ""
"Programtillegget fjerner de uriktige profilene som er tildelt av GLPI og "
"kobler eksplisitt sammen profilen <strong>%s</strong> og enheten "
"<strong>%s</strong> ved å bruke klassen <code>Profile_User</code>."

msgid "Email Validation"
msgstr "E-postvalidering"

msgid "User found by email: <strong>%s</strong> (ID: %d)"
msgstr "Bruker funnet på e-post: <strong>%s</strong> (ID: %d)"

msgid "Domain Restriction Check"
msgstr "Kontroll av domenebegrensninger"

msgid "None"
msgstr "Ingen"

msgid "Session::init() — Login Performed"
msgstr "Session::init() — Innlogging utført"

msgid "Execution Chain (Step-by-Step)"
msgstr "Utførelseskjede (trinn-for-trinn)"

msgid "Login to Existing Account"
msgstr "Logg inn på eksisterende konto"

msgid "How it works:"
msgstr "Slik fungerer det:"

msgid ""
"In GLPI 11, the core ignores the profile passed by external authentications "
"and automatically assigns the global default profile (usually Self-Service) "
"to the new user."
msgstr ""
"I GLPI 11 ignorerer kjernen profilen som sendes av eksterne autentiseringer "
"og tildeler automatisk den globale standardprofilen (vanligvis "
"selvbetjening) til den nye brukeren."

msgid "Final Entity"
msgstr "Endelig enhet"

msgid "Final Result"
msgstr "Endelig resultat"

msgid "Back to Login"
msgstr "Tilbake til pålogging"

msgid "Simulated Email:"
msgstr "Simulert e-post:"

msgid ""
"Restrict domain: <strong>%s</strong> | Auto create users: "
"<strong>%s</strong>"
msgstr ""
"Begrens domene: <strong>%s</strong> | Opprett brukere automatisk: "
"<strong>%s</strong>"

msgid "Final Profile"
msgstr "Endelig profil"

msgid ""
"The user \"%s\" would be created, but without ANY profile. Access to GLPI "
"would be denied. Please configure a valid profile in the Default Rule or "
"Domain Rules."
msgstr ""
"Brukeren \"%s\" vil bli opprettet, men uten NOEN profil. Tilgang til GLPI "
"ville bli nektet. Konfigurer en gyldig profil i standardregelen eller "
"domenereglene."

msgid "GLPI Core step"
msgstr "GLPI Core trinn"

msgid ""
"No valid profile (ID > 0) was found in the plugin rules. The user would be "
"created WITHOUT a profile."
msgstr ""
"Ingen gyldig profil (ID > 0) ble funnet i plugin-reglene. Brukeren vil bli "
"opprettet UTEN profil."
