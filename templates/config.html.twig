{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="card col-12 col-lg-8 mx-auto my-4">
    <div class="card-header">
        <h3 class="card-title">{{ __('Google SSO — Configuration', 'googlesso') }}</h3>
    </div>
    <div class="card-body">
        <div style="background: #eef9fd; border-left: 4px solid #178abb; padding: 1rem; margin-bottom: 1.5rem; border-radius: 4px;">
            <h3 style="margin-top: 0; font-size: 1.2rem; color: #178abb;">{{ __('How to enable Google SSO integration?', 'googlesso') }}</h3>
            
            <p style="margin-bottom: 0.5rem;"><strong>{{ __('Step 1: Google Cloud Preparation', 'googlesso') }}</strong></p>
            <ol style="line-height: 1.6; margin-bottom: 1rem; padding-left: 1.2rem;">
                <li>{{ __('Access the <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a> and create a new <strong>Project</strong>.', 'googlesso')|raw }}</li>
                <li>{{ __('Go to <strong>APIs &amp; Services &gt; OAuth consent screen</strong> and configure your app (add the scopes <code>email</code>, <code>profile</code>, and <code>openid</code>).', 'googlesso')|raw }}</li>
                <li>{{ __('Then go to <strong>Credentials &gt; Create Credentials &gt; OAuth client ID</strong>, choosing the <strong>Web application</strong> type.', 'googlesso')|raw }}</li>
                <li>{{ __('Under <strong>Authorized redirect URIs</strong>, copy and paste exactly the return URL below:', 'googlesso')|raw }}
                    <ul style="margin-top: 0.5rem; margin-bottom: 0.5rem; list-style-type: disc;">
                        <li><strong>{{ __('Redirect URI:', 'googlesso') }}</strong> <code>{{ redirect_uri }}</code></li>
                    </ul>
                </li>
                <li>{{ __('Google will generate a <strong>Client ID</strong> and a <strong>Client Secret</strong>. Fill in the fields in this form with those keys.', 'googlesso')|raw }}</li>
            </ol>

            <p style="margin-bottom: 0.5rem;"><strong>{{ __('Step 2: GLPI Authentication Preparation', 'googlesso') }}</strong></p>
            <ol style="line-height: 1.6; margin-bottom: 0; padding-left: 1.2rem;">
                <li>{{ __('In GLPI, go to <strong>Setup &gt; Authentication &gt; Setup</strong>.', 'googlesso')|raw }}</li>
                <li>{{ __('Change the <strong>Automatically add users from an external authentication source</strong> field to <strong>Yes</strong>.', 'googlesso')|raw }}</li>
                <li><strong style="color: #d32f2f;">{{ __('Critical Warning:', 'googlesso') }}</strong> {{ __('Leave the option <strong>"Remove domain of logins in form login@domain"</strong> as <strong>No</strong>. If enabled, users with the same prefix in different providers (e.g., admin@gmail.com and admin@institution.edu.br) will suffer account overlap.', 'googlesso')|raw }}</li>
                <li>{{ __('Check the <strong>Activate "Sign in with Google" button</strong> option below and click <strong>Save</strong>.', 'googlesso')|raw }}</li>
            </ol>
        </div>

        <div class="alert alert-info">
            {{ __('Register this Redirect URI in Google Cloud Console:', 'googlesso') }}
            <code>{{ redirect_uri }}</code>
        </div>

        <form method="post" action="{{ action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

            <div class="mb-3">
                <label class="form-label" for="client_id">Client ID</label>
                <input type="text" class="form-control" id="client_id" name="client_id"
                       value="{{ config.client_id }}" placeholder="[GOOGLE_CLIENT_ID]">
            </div>

            <div class="mb-3">
                <label class="form-label" for="client_secret">Client Secret</label>
                <input type="password" class="form-control" id="client_secret" name="client_secret"
                       value="" autocomplete="new-password"
                       placeholder="{{ config.client_secret ? '••••••••••' : '[GOOGLE_CLIENT_SECRET]' }}">
                <small class="form-hint">{{ __('Leave blank to keep current secret (stored encrypted).', 'googlesso') }}</small>
            </div>

            <div class="mb-3">
                <label class="form-label" for="restrict_domain">{{ __('Restrict to domain (optional)', 'googlesso') }}</label>
                <input type="text" class="form-control" id="restrict_domain" name="restrict_domain"
                       value="{{ config.restrict_domain }}" placeholder="company.com">
                <small class="form-hint">{{ __('Subdomains are also accepted. E.g.: "company.com" will allow user@company.com and user@sub.company.com.', 'googlesso') }}</small>
            </div>

            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="auto_create_users" value="0">
                    <input class="form-check-input" type="checkbox" name="auto_create_users" id="auto_create_chk" value="1"
                           {{ config.auto_create_users ? 'checked' : '' }}>
                    <span class="form-check-label">{{ __('Automatically create users on first login', 'googlesso') }}</span>
                </label>
            </div>

            <div id="domain_rules_section">
            <hr class="my-4">
            <h4>{{ __('Profile and Entity Rules by Domain', 'googlesso') }}</h4>
            <div class="alert alert-secondary">
                {{ __('Add rules to define which profile and entity the user will receive based on their email domain (Optional).', 'googlesso') }}
            </div>
            
            <table class="table table-sm table-bordered" id="domain-rules-table" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th style="width: 33%;">{{ __('Domain (after @)', 'googlesso') }}</th>
                        <th style="width: 33%;">{{ __('Profile', 'googlesso') }}</th>
                        <th style="width: 33%;">{{ __('Entity', 'googlesso') }}</th>
                        <th style="width: 50px;"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for rule in config.domain_rules %}
                        <tr>
                            <td>
                                <input type="text" name="domain_rule_domain[]" class="form-control" value="{{ rule.domain }}" required>
                            </td>
                            <td>
                                <select name="domain_rule_profile_id[]" class="form-select searchable-select" required>
                                    <option value="">{{ __('Select...', 'googlesso') }}</option>
                                    {% for id, name in profiles %}
                                        <option value="{{ id }}" {{ id == rule.profile_id ? 'selected' : '' }}>{{ name }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>
                                <select name="domain_rule_entity_id[]" class="form-select searchable-select" required>
                                    <option value="">{{ __('Select...', 'googlesso') }}</option>
                                    {% for id, name in entities %}
                                        <option value="{{ id }}" {{ id == rule.entity_id ? 'selected' : '' }}>{{ name }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td class="text-center align-middle">
                                <button type="button" class="btn btn-icon btn-danger btn-sm btn-remove-rule"><i class="ti ti-trash"></i></button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <button type="button" class="btn btn-outline-primary btn-sm mb-4" id="btn-add-rule">
                <i class="ti ti-plus me-1"></i> {{ __('Add Rule', 'googlesso') }}
            </button>

            <table style="display:none;">
                <tbody id="rule-template">
                    <tr>
                        <td>
                            <input type="text" name="domain_rule_domain[]" class="form-control" placeholder="ex: aluno.edu.br" required disabled>
                        </td>
                        <td>
                            <select name="domain_rule_profile_id[]" class="form-select" required disabled>
                                <option value="">{{ __('Select...', 'googlesso') }}</option>
                                {% for id, name in profiles %}
                                    <option value="{{ id }}">{{ name }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            <select name="domain_rule_entity_id[]" class="form-select" required disabled>
                                <option value="">{{ __('Select...', 'googlesso') }}</option>
                                {% for id, name in entities %}
                                    <option value="{{ id }}">{{ name }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td class="text-center align-middle">
                            <button type="button" class="btn btn-icon btn-danger btn-sm btn-remove-rule"><i class="ti ti-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>

            <hr class="my-4">
            <h4>{{ __('Default Rule (Fallback)', 'googlesso') }}</h4>
            <div class="alert alert-secondary">
                {{ __('If the user email does not match any of the rules above, this profile and entity will be used. Mandatory if automatic creation is enabled.', 'googlesso') }}
            </div>

            {{ fields.dropdownField('Profile', 'default_profile_id', config.default_profile_id,
                __('Default profile (ELSE)', 'googlesso')) }}

            {{ fields.dropdownField('Entity', 'default_entity_id', config.default_entity_id,
                __('Default entity (ELSE)', 'googlesso')) }}

            <div style="background: #eef9fd; border-left: 4px solid #178abb; padding: 12px 16px; border-radius: 4px; color: #1a3e72; font-size: 14px; margin-top: 15px;">
                <strong>🧪 {{ __('Simulator:', 'googlesso') }}</strong> {{ __('To test the account creation rules and discover which Profile/Entity will be assigned to an email,', 'googlesso') }}
                <a href="{{ root_doc }}/plugins/googlesso/front/simulator.php" style="color: #178abb; font-weight: 600; text-decoration: none;">{{ __('click here', 'googlesso') }}</a>.
            </div>
            </div>

            <hr class="my-4">
            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="is_active" value="0">
                    <input class="form-check-input" type="checkbox" name="is_active" value="1"
                           {{ config.is_active ? 'checked' : '' }}>
                    <span class="form-check-label">{{ __('Activate "Sign in with Google" button', 'googlesso') }}</span>
                </label>
            </div>

            <div class="mt-4 text-end">
                <button type="submit" name="update" value="1" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'googlesso') }}
                </button>
            </div>
        </form>
    </div>
</div>

<script>
$(function() {
    function toggleDomainRules() {
        if ($('#auto_create_chk').is(':checked')) {
            $('#domain_rules_section').show();
        } else {
            $('#domain_rules_section').hide();
        }
    }
    
    $('#auto_create_chk').on('change', toggleDomainRules);
    toggleDomainRules();
    function initSearchable($context) {
        var $selects = $context.find('.searchable-select');
        if (typeof $.fn.select2 === 'function') {
            $selects.select2({width: '100%'});
        } else if (typeof TomSelect !== 'undefined') {
            $selects.each(function() {
                if (!this.tomselect) new TomSelect(this);
            });
        }
    }
    initSearchable($(document));

    $('#btn-add-rule').on('click', function() {
        var $newRow = $('#rule-template tr').clone();
        $newRow.find(':input').prop('disabled', false);
        $('#domain-rules-table tbody').first().append($newRow);
        initSearchable($newRow);
    });

    $('#domain-rules-table').on('click', '.btn-remove-rule', function() {
        $(this).closest('tr').remove();
    });
});
</script>
